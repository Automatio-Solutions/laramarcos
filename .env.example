# LaraMarcos Asesores — variables de entorno (copiar a .env.local, que está gitignored)

# --- Supabase: necesario para aplicar la migración y correr los tests RLS ---
# Connection string (URI) del proyecto. Dashboard → Project Settings → Database →
# Connection string → "URI" (incluye la contraseña). Imprescindible para db:apply y db:rls-test.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# --- Supabase: para la app Next.js (más adelante) ---
NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (M2 presupuestos, M3 clasificación, M4 OCR) ---
ANTHROPIC_API_KEY=
# Opcional: fuerza otro modelo (por defecto claude-opus-4-8)
ANTHROPIC_MODEL=

# --- Resend: envío de presupuestos (M2) y circulares DOE/BOE (M3) ---
# Dominio verificado: laramarcosasesores.es (DKIM + SPF sobre el subdominio send)
RESEND_API_KEY=

# URL pública de la app: necesaria para el enlace de aceptación del presupuesto
NEXT_PUBLIC_APP_URL=https://crm.laramarcosasesores.es

# --- Cron: protege /api/cron/* (cabecera x-cron-secret) ---
CRON_SECRET=
