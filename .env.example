# LaraMarcos Asesores — variables de entorno (copiar a .env.local, que está gitignored)

# --- Supabase: necesario para aplicar la migración y correr los tests RLS ---
# Connection string (URI) del proyecto. Dashboard → Project Settings → Database →
# Connection string → "URI" (incluye la contraseña). Imprescindible para db:apply y db:rls-test.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# --- Supabase: para la app Next.js (más adelante) ---
NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Otros servicios (módulos posteriores) ---
RESEND_API_KEY=
ANTHROPIC_API_KEY=
