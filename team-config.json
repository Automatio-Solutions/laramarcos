{
  "$schema": "SpecBox Engine v3.9.0 - Agent Teams Configuration (Orchestrator Isolation)",
  "team": {
    "name": "laramarcos-asesores",
    "description": "Equipo de desarrollo para laramarcos-asesores",
    "maxConcurrentTeammates": 3
  },
  "orchestrator": {
    "model": "opus",
    "prompt": "agent-teams/prompts/orchestrator.md",
    "maxContextBudget": "15%",
    "responsibilities": [
      "Parsear planes y extraer fases",
      "Delegar cada fase a un sub-agente limpio via Task tool",
      "Recibir reportes estructurados de sub-agentes",
      "Consolidar resumenes en Engram (mem_save)",
      "Guardar checkpoints entre fases",
      "Decidir self-healing si una fase falla",
      "Crear rama, commits parciales y PR",
      "NUNCA leer archivos fuente del proyecto",
      "NUNCA escribir ni editar codigo directamente",
      "NUNCA ejecutar lint, tests o build directamente"
    ],
    "fileOwnership": ["doc/plans/", ".quality/evidence/"],
    "canDelegate": true,
    "canImplement": false,
    "canReadSourceFiles": false,
    "canWriteCode": false
  },
  "roles": {
    "DesignSpecialist": {
      "model": "sonnet",
      "prompt": "agent-teams/prompts/design-specialist.md",
      "responsibilities": ["Generacion de diseños via Stitch MCP", "Conversion HTML a codigo", "Design system"],
      "fileOwnership": ["doc/design/"],
      "priority": "FIRST",
      "note": "Lanzar primero: Stitch tarda minutos por pantalla"
    },
    "ReactSpecialist": {
      "model": "sonnet",
      "prompt": "agent-teams/prompts/react-specialist.md",
      "responsibilities": ["Next.js App Router", "Server Components + TanStack Query", "Tailwind CSS"],
      "fileOwnership": ["src/app/", "src/components/", "src/hooks/", "src/stores/"]
    },
    "DBInfra": {
      "model": "sonnet",
      "prompt": "agent-teams/prompts/db-infra.md",
      "responsibilities": ["Supabase/Neon/Firebase", "Migraciones y schemas", "RLS policies", "Stripe integracion"],
      "fileOwnership": ["supabase/", "migrations/", "prisma/"]
    },
    "QAReviewer": {
      "model": "sonnet",
      "prompt": "agent-teams/prompts/qa-reviewer.md",
      "responsibilities": ["Tests unitarios, widget, integracion", "Coverage 85%+", "Edge cases + fuzz testing"],
      "fileOwnership": ["test/", "tests/", "__tests__/"]
    },
    "AcceptanceTester": {
      "model": "sonnet",
      "prompt": "agent-teams/prompts/acceptance-tester.md",
      "responsibilities": ["Generar E2E/integration tests desde AC-XX del PRD", "Capturar evidencia visual (screenshots, traces)", "Ejecutar tests y reportar resultados"],
      "fileOwnership": ["test/acceptance/", "tests/acceptance/", ".quality/evidence/**/acceptance/"]
    },
    "AcceptanceValidator": {
      "model": "sonnet",
      "prompt": "agent-teams/prompts/acceptance-validator.md",
      "responsibilities": ["Validacion independiente de acceptance criteria", "Verificar implementacion contra PRD", "Emitir veredicto ACCEPTED/CONDITIONAL/REJECTED"],
      "fileOwnership": [".quality/evidence/"]
    }
  },
  "qualityGates": {
    "preCommit": {
      "react": "npx eslint . --fix && npx tsc --noEmit && npx jest"
    },
    "minCoverage": 85
  },
  "notes": {
    "reactOnly": "Orchestrator + DesignSpecialist + ReactSpecialist + DBInfra + QAReviewer + AcceptanceTester + AcceptanceValidator",
    "orchestratorRule": "El Orchestrator NUNCA implementa codigo. Solo planifica, delega, consolida y persiste en Engram.",
    "contextBudget": "Cada Task recibe max ~20,000 tokens. Si una fase excede 30% de ventana, splitear en sub-fases."
  }
}
